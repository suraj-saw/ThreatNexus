# ThreatNexus Worker Machine Environment Configuration
# Set MASTER_IP to the IPv4 address of the Master PC on your LAN (e.g., 192.168.1.50)
MASTER_IP=192.168.1.10

# Set WORKER_HOSTNAME to worker1 for Machine 2, and worker2 for Machine 3
WORKER_HOSTNAME=worker1

# Hardware allocation for Spark distributed worker
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G

# Host port overrides (optional; keep defaults unless ports are occupied)
DATANODE_HTTP_PORT=9864
DATANODE_DATA_PORT=9866
SPARK_WORKER_UI_PORT=8081
REGIONSERVER_PORT=16020
REGIONSERVER_INFO_PORT=16030
